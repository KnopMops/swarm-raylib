{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"command": "E:/raylib/w64devkit/bin/g++.exe",
			"args": [
				"${workspaceFolder}/src/*.cpp",
				"-o",
				"${workspaceFolder}/build/main.exe",
				"-I",
				"E:/raylib/raylib/src",
				"-L",
				"E:/raylib/raylib/src",
				"-lraylib",
				"-lopengl32",
				"-lgdi32",
				"-lwinmm"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc",
			"options": {
				"env": {
					"PATH": "E:/raylib/w64devkit/bin;${env:PATH}"
				}
			}
		}
	]
}
